doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(http-equiv="X-UA-Compatible", content="IE=edge")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Hamro Idea | Digital Marketing & Web Development Agency in Nepal
        meta(name="description", content="Hamro Idea is a Nepal-based digital marketing and web development agency delivering SEO, websites, web apps, and mobile solutions that drive measurable growth.")
        meta(name="robots", content="index, follow")
        link(rel="canonical", href="https://hamroidea.com/")

        meta(property="og:type", content="website")
        meta(property="og:title", content="Hamro Idea | Digital Marketing & Web Development Agency in Nepal")
        meta(property="og:description", content="SEO, digital marketing, and custom web development services for Nepal-based and global businesses.")
        meta(property="og:url", content="https://hamroidea.com/")
        meta(property="og:image", content="https://hamroidea.com/assets/images/Logo-dark.png")

        meta(name="twitter:card", content="summary_large_image")
        meta(name="twitter:title", content="Hamro Idea | Digital Marketing & Web Development Agency in Nepal")
        meta(name="twitter:description", content="SEO, digital marketing, and custom web development services for Nepal-based and global businesses.")
        meta(name="twitter:image", content="https://hamroidea.com/assets/images/Logo-dark.png")

        script(type="application/ld+json").
            {
              "@context": "https://schema.org",
              "@type": "Organization",
              "name": "Hamro Idea",
              "url": "https://hamroidea.com/",
              "logo": "https://hamroidea.com/assets/images/Logo-dark.png",
              "sameAs": [
                "https://www.facebook.com/",
                "https://www.instagram.com/",
                "https://www.linkedin.com/"
              ]
            }

        //- Theme Css
        link(rel="stylesheet", href="assets/css/main.css")

        //- Carousel Css - GLIDER
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/glider-js@1/glider.min.css")

        //- Fonts
        link(rel="preconnect", href="https://fonts.googleapis.com")
        link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
        link(href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap", rel="stylesheet")

    body
        a.skip-link(href="#main-content") Skip to content
        header.site-header
            include ../organisms/navbar
        .cursor
        main#main-content.page-content
            block content

        include ../organisms/footer

        //- Glider JS
        script(src="https://cdn.jsdelivr.net/npm/glider-js@1/glider.min.js")

        //- Animation Libraries
        script(src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js")
        script(src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js")
        script(src="https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.12.2/lottie_light.min.js")
        
        script(src="assets/js/all.js")
        script(src="assets/js/page-ui.js", defer)
