//- Our Approach
.our-apporach
    .container
        h2.title Our Approach 

        .row.approach-box.justify-content-between
            .h-col-4
                .approach-item
                    h4.title Discuss
                    p.content We align on goals, audiences, and success metrics before any build begins.

            .h-col-4
                .approach-item
                    h4.title Research
                    p.content We validate assumptions, audit competitors, and define the right technical path.

            .h-col-4
                .approach-item
                    h4.title Plan & Schedule
                    p.content We map scope, milestones, and stack choices to keep delivery predictable.

            .h-col-4
                .approach-item
                    h4.title Development & Testing
                    p.content Agile delivery with continuous QA ensures stability, speed, and performance.

            .h-col-4
                .approach-item
                    h4.title UAT & Revisions
                    p.content Your team validates the build, and we refine based on real feedback.

            .h-col-4
                .approach-item
                    h4.title Hands Off
                    p.content We deploy, train, and hand over the product with clear documentation.
