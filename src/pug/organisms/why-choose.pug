//- Why Choose Section
section.why-choose
    .container
        .why-choose__header
            .why-choose__icon
                svg(width="40", height="40", viewBox="0 0 40 40", fill="none", xmlns="http://www.w3.org/2000/svg")
                    rect(width="40", height="40", rx="8", fill="#121984")
                    path(d="M20 11L23.6 17.8L31 18.6L25.4 23.5L27 30.8L20 27L13 30.8L14.6 23.5L9 18.6L16.4 17.8L20 11Z", fill="white")
            h2.why-choose__title Why Leading Enterprises Choose Hamro Idea
            p.why-choose__subtitle From scalable platforms to AI-driven automation, we partner with organizations to build digital solutions that solve real business problems and deliver measurable results.

        .why-choose__content
            .why-choose__list
                .why-choose__card
                    .why-choose__card-icon
                        svg(width="22", height="22", viewBox="0 0 24 24", fill="none", stroke="#121984", stroke-width="2")
                            rect(x="3", y="3", width="18", height="18", rx="4")
                            path(d="M7 12h10")
                            path(d="M12 7v10")
                    .why-choose__card-body
                        h3 98% Client Retention
                        p Our commitment to consistent value earns long-term trust across multi-phase digital engagements.

                .why-choose__card
                    .why-choose__card-icon
                        svg(width="22", height="22", viewBox="0 0 24 24", fill="none", stroke="#121984", stroke-width="2")
                            rect(x="3", y="3", width="18", height="18", rx="4")
                            path(d="M7 9h10")
                            path(d="M7 15h10")
                    .why-choose__card-body
                        h3 Applied AI In 8+ Industries
                        p We deliver AI solutions across finance, healthcare, eCommerce, public sector, and more.

                .why-choose__card
                    .why-choose__card-icon
                        svg(width="22", height="22", viewBox="0 0 24 24", fill="none", stroke="#121984", stroke-width="2")
                            circle(cx="12", cy="12", r="9")
                            path(d="M12 8v4l3 2")
                    .why-choose__card-body
                        h3 Proven Expertise
                        p Integrated teams accelerate delivery while reducing time-to-market and internal resource strain.

            .why-choose__media
                img(src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=1200&q=80", alt="Hamro Idea team collaborating")
