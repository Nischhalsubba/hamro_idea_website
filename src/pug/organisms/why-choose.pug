//- Why Choose Section
section.why-choose
    .container
        .why-choose__header
            .why-choose__icon.section-icon
                svg(width="24", height="24", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linejoin="round", xmlns="http://www.w3.org/2000/svg")
                    path(d="M12 2L14.9 8.2L21.7 9.2L16.8 13.9L18.1 20.7L12 17.3L5.9 20.7L7.2 13.9L2.3 9.2L9.1 8.2L12 2Z")
