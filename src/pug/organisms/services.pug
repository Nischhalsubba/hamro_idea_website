//- Services Section (Split Sticky Layout)
section.services
    .container
        .services__wrapper
            //- Left Sticky Column
            .services__sticky
                .sticky-content
                    .icon-cube
                        svg(width="32", height="32", viewBox="0 0 24 24", fill="none", xmlns="http://www.w3.org/2000/svg")
                            rect(x="2", y="2", width="20", height="20", rx="4", fill="#091071")
                            path(d="M8 8L16 16M16 8L8 16", stroke="white", stroke-width="2", stroke-linecap="round")
                            
                    h2.services__title Our Services,#[br]Your Competitive Edge.
                    p.services__description From idea to launch, we build tailored software that supports your business objectives.

            //- Right Scrollable Column
            .services__list
                //- Item 01
                .service-item
                    span.item-number 01
                    .item-dot
                    h3.item-title Business Model Transformation
                    p.item-desc We bring together strategic thinking and entrepreneurial execution to guide your business through meaningful digital transformation—helping you innovate, operate more efficiently, and grow confidently in a competitive landscape.
                    a.item-link(href="#") Unlock Strategic Value 
                        span.arrow →

                //- Item 02
                .service-item
                    span.item-number 02
                    .item-dot
                    h3.item-title Artificial Intelligence Tailored Services
                    p.item-desc Data alone isn't enough to drive success—it's what you do with it that matters. Our AI services help you convert information into intelligence, enabling smarter strategies, streamlined operations, and long-term competitive advantage.
                    a.item-link(href="#") Discover AI Possibilities 
                        span.arrow →

                //- Item 03
                .service-item
                    span.item-number 03
                    .item-dot
                    h3.item-title Individual Software Solutions
                    p.item-desc Our process begins with your vision and ends with a fully realized digital product that meets your goals. From concept through deployment, we design and build robust, scalable software with a focus on quality.
                    a.item-link(href="#") Explore Our Tech Stack 
                        span.arrow →

                //- Item 04
                .service-item
                    span.item-number 04
                    .item-dot
                    h3.item-title Embedded Teams
                    p.item-desc Supercharge your initiatives by embedding experienced, entrepreneurial talent directly into your teams. Our experts align with your goals, processes, and culture—contributing not just skills, but strategic thinking.
                    a.item-link(href="#") Learn More About It 
                        span.arrow →

                //- Item 05
                .service-item
                    span.item-number 05
                    .item-dot
                    h3.item-title Application Management
                    p.item-desc We ensure your applications remain reliable, efficient, and fully optimized at all times. Our team manages everything from ongoing maintenance to performance tuning.
                    a.item-link(href="#") Optimize Your Applications 
                        span.arrow →
