//- Hero Section
.hero
    .hero-bg-gradient
    .hero-noise
    
    .container
        .hero-wrapper
            .hero-content
                h1.hero-title Partnering with you to convert digital marketing ideas into high-performing websites, web apps, and mobile experiences.
                
                h2.hero-subtitle Serving startups, NGOs, and growing businesses with digital marketing, website, and mobile app development since 2012.
                
                p.hero-desc We are a Nepal-based team of creative technologists focused on measurable growth, reliable delivery, and digital products that solve real business problems.
                
                .hero-actions
                    a.btn.btn--icon-block(href="#") 
                        span.text Our Services
                        span.btn-icon-box
                            svg(width="12", height="12", viewBox="0 0 16 16", fill="none", xmlns="http://www.w3.org/2000/svg")
                                path(d="M8 0L6.59 1.41L12.17 7H0V9H12.17L6.59 14.59L8 16L16 8L8 0Z", fill="white")

        .hero-footer-bar
            span.footer-label Trusted by Nepal-forward teams
            .footer-logos
                span.footer-logo
                    svg(width="38", height="18", viewBox="0 0 76 36", fill="none", xmlns="http://www.w3.org/2000/svg")
                        rect(x="2", y="2", width="32", height="32", stroke="currentColor", stroke-width="3")
                        rect(x="14", y="2", width="20", height="32", fill="currentColor", opacity="0.5")
                    span.footer-logo__text Summit
                span.footer-logo
                    svg(width="38", height="18", viewBox="0 0 76 36", fill="none", xmlns="http://www.w3.org/2000/svg")
                        circle(cx="18", cy="18", r="14", stroke="currentColor", stroke-width="3")
                        path(d="M28 18H48", stroke="currentColor", stroke-width="3")
                        path(d="M48 18L58 8", stroke="currentColor", stroke-width="3")
                    span.footer-logo__text Cloudpeak
                span.footer-logo
                    svg(width="38", height="18", viewBox="0 0 76 36", fill="none", xmlns="http://www.w3.org/2000/svg")
                        path(d="M10 26V10L26 6L42 10V26L26 30L10 26Z", stroke="currentColor", stroke-width="3")
