//- Hero Section
.hero
    .hero-bg-gradient
    .hero-noise
    
    .container
        .hero-wrapper
            .hero-content
                h1.hero-title Design, development, and digital systems for businesses ready to grow.
                
                h2.hero-subtitle Websites, web apps, CMS platforms, and custom software built with a strategy-first process.
                
                p.hero-desc Hamro Idea helps startups, local businesses, and growing teams build high-performing websites, web apps, CMS platforms, and custom software with clear planning, design, and development.
                .hero-actions
                    a.btn.btn--icon-block(href="/services/start-a-new-project.html") 
                        span.text Book a Project Call
                        span.btn-icon-box
                            svg(width="12", height="12", viewBox="0 0 16 16", fill="none", xmlns="http://www.w3.org/2000/svg")
                                path(d="M8 0L6.59 1.41L12.17 7H0V9H12.17L6.59 14.59L8 16L16 8L8 0Z", fill="white")
                    a.btn.btn--ghost(href="/work.html") View Case Studies

        .hero-footer-bar
            span.footer-label What we build
            .footer-logos
                span.footer-logo: span.footer-logo__text Websites & Web Apps
                span.footer-logo: span.footer-logo__text Custom CMS
                span.footer-logo: span.footer-logo__text Custom Software
                span.footer-logo: span.footer-logo__text SEO & Growth

