//- Hero Section
.hero
    .hero-bg-gradient
    
    .container
        .hero-wrapper
            .hero-content
                h1.hero-title Partnering with you to convert your digital marketing ideas into reality with our team of dedicated professionals.
                
                h2.hero-subtitle Serving all kinds of clients with digital marketing, website and mobile app development needs since 2012.
                
                p.hero-desc We are a team of Creative enthusiasts based in Nepal determined to implement our client's digital marketing ideas into reality that delivers and solve problems.
                
                .hero-actions
                    a.btn.btn-white-composite(href="#") 
                        span.text Our Services
                        span.icon-box
                            svg(width="12", height="12", viewBox="0 0 16 16", fill="none", xmlns="http://www.w3.org/2000/svg")
                                path(d="M8 0L6.59 1.41L12.17 7H0V9H12.17L6.59 14.59L8 16L16 8L8 0Z", fill="white")

        .hero-footer-bar
            span.footer-label You Can Read More From Us
            .footer-logos
                //- Placeholders for logos (IPSUM, LOGO, etc.)
                span.logo-placeholder IPSUM
                span.logo-placeholder LOOO
                span.logo-placeholder VisionOS
