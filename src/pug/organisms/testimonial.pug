//- Testimonial
section.testimonial
    .container
        .testimonial__header
            .testimonial__icon
                svg(width="40", height="40", viewBox="0 0 40 40", fill="none", xmlns="http://www.w3.org/2000/svg")
                    rect(width="40", height="40", rx="8", fill="#121984")
                    path(d="M20 10L22.85 16.15L29.6 16.9L24.6 21.35L26.1 28L20 24.6L13.9 28L15.4 21.35L10.4 16.9L17.15 16.15L20 10Z", fill="white")
            h2.testimonial__title Our Users Say It Best.
            p.testimonial__subtitle Don't just take our word for it -- here's what our clients share after partnering with Hamro Idea.

        .testimonial__slider-wrap
            .card-slider
                .card
                    p.testimonial__quote "Quote coming soon."
                    .testimonial__footer
                        .testimonial__profile
                            span.testimonial__avatar BL
                            .testimonial__meta
                                h5.testimonial__name Belen
                                span.testimonial__role Client

                .card
                    p.testimonial__quote "Quote coming soon."
                    .testimonial__footer
                        .testimonial__profile
                            span.testimonial__avatar JA
                            .testimonial__meta
                                h5.testimonial__name James
                                span.testimonial__role Client

                .card
                    p.testimonial__quote "Quote coming soon."
                    .testimonial__footer
                        .testimonial__profile
                            span.testimonial__avatar AD
                            .testimonial__meta
                                h5.testimonial__name Adam
                                span.testimonial__role Client

                .card
                    p.testimonial__quote "Quote coming soon."
                    .testimonial__footer
                        .testimonial__profile
                            span.testimonial__avatar AN
                            .testimonial__meta
                                h5.testimonial__name Andy
                                span.testimonial__role Client

                .card
                    p.testimonial__quote "Hamro Idea was quick to support us with any post launch changes and kept providing solutions to the number of on-the-ground challenges we met during the project tenure."
                    .testimonial__footer
                        .testimonial__profile
                            span.testimonial__avatar RN
                            .testimonial__meta
                                h5.testimonial__name RISMFP, Nepalgunj
                                span.testimonial__role Management Information System (MIS) Development

                .card
