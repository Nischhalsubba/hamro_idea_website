//- Testimonial
section.testimonial
    .container
        .testimonial__header
            .testimonial__icon.section-icon
                svg(width="24", height="24", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linejoin="round", xmlns="http://www.w3.org/2000/svg")
                    path(d="M12 2L14.9 8.2L21.7 9.2L16.8 13.9L18.1 20.7L12 17.3L5.9 20.7L7.2 13.9L2.3 9.2L9.1 8.2L12 2Z")
            h2.testimonial__title Our Users Say It Best.
            p.testimonial__subtitle Don't just take our word for it -- here is what clients share after partnering with Hamro Idea.

        .testimonial__slider-wrap
            .card-slider
                .card
                    p.testimonial__quote "Hamro Idea translated our vision into a fast, reliable platform that our team can maintain without constant support."
                    .testimonial__footer
                        .testimonial__profile
                            span.testimonial__avatar BL
                            .testimonial__meta
                                h5.testimonial__name Belen Lama
                                span.testimonial__role Operations Manager, Retail & Logistics

                .card
                    p.testimonial__quote "Their communication was crisp, timelines were realistic, and the final product felt polished from day one."
                    .testimonial__footer
                        .testimonial__profile
                            span.testimonial__avatar JA
                            .testimonial__meta
                                h5.testimonial__name James Adhikari
                                span.testimonial__role Director, Emerging Markets Initiative

                .card
                    p.testimonial__quote "We needed a CMS that could scale with our content. Hamro Idea built it cleanly, and our editors love it."
                    .testimonial__footer
                        .testimonial__profile
                            span.testimonial__avatar AS
                            .testimonial__meta
                                h5.testimonial__name Adam Sharma
                                span.testimonial__role Communications Lead, Social Impact Org

                .card
                    p.testimonial__quote "The site feels modern, loads quickly, and helped us book more qualified inquiries within weeks."
                    .testimonial__footer
                        .testimonial__profile
                            span.testimonial__avatar AL
                            .testimonial__meta
                                h5.testimonial__name Andy Lama
                                span.testimonial__role Founder, Hospitality Group

                .card
                    p.testimonial__quote "Hamro Idea was quick to support post-launch changes and kept providing solutions to the on-the-ground challenges we faced during the project tenure."
                    .testimonial__footer
                        .testimonial__profile
                            span.testimonial__avatar RN
                            .testimonial__meta
                                h5.testimonial__name Raising Incomes of Small and Medium Farmers Project (RISMFP)
                                span.testimonial__role Management Information System (MIS) Development, Nepalgunj

                .card
                    p.testimonial__quote "We are very pleased with the level of expertise and the friendly staff. We gladly recommend Hamro Idea for web-based software, mobile apps, and website development."
                    .testimonial__footer
                        .testimonial__profile
                            span.testimonial__avatar RI
                            .testimonial__meta
                                h5.testimonial__name Raising Incomes of Small and Medium Farmers Project (RISMFP)
                                span.testimonial__role Management Information System (MIS) Development

                .card
                    p.testimonial__quote "Hamro Idea delivered with clarity and care throughout the engagement."
                    .testimonial__footer
                        .testimonial__profile
                            span.testimonial__avatar RD
                            .testimonial__meta
                                h5.testimonial__name Raja Dongol
                                span.testimonial__role CHDW

                .card
                    p.testimonial__quote "The team was professional, responsive, and invested in our success."
                    .testimonial__footer
                        .testimonial__profile
                            span.testimonial__avatar SS
                            .testimonial__meta
                                h5.testimonial__name Subesth Shrestha
                                span.testimonial__role CEO, BideshJane

        .section-controls
            button.section-control.glider-prev(aria-label="Previous")
                svg(width="10", height="16", viewBox="0 0 10 16", xmlns="http://www.w3.org/2000/svg")
                    path(d="M9.2 1.6L7.8 0.2L0.6 8L7.8 15.8L9.2 14.4L3.4 8L9.2 1.6Z", fill="currentColor")
            button.section-control.section-control--primary.glider-next(aria-label="Next")
                svg(width="10", height="16", viewBox="0 0 10 16", xmlns="http://www.w3.org/2000/svg")
                    path(d="M0.8 14.4L2.2 15.8L9.4 8L2.2 0.2L0.8 1.6L6.6 8L0.8 14.4Z", fill="currentColor")
