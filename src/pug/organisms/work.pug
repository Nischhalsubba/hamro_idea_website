section.work
    .container
        .row.justify-content-between.align-items-center
            h2.title Our Work

        .card-slider
            .card
                h5.title Dirty Pineapple
                a.link(href="https://www.dirtypineapple.net/", target="_blank") www.dirtypineapple.net
                span.badge.badge-outline-primary Web
            
            .card
                h5.title Rengaskeskus
                a.link(href="https://rengaskeskus.fi/", target="_blank") www.rengaskeskus.fi
                span.badge.badge-outline-primary Web

            .card
                h5.title Irongate Armory
                a.link(href="https://irongatearmory.com/", target="_blank") www.irongatearmory.com
                span.badge.badge-outline-primary E-com

            .card
                h5.title CHDW
                a.link(href="https://chdw.org.np/", target="_blank") www.chdw.org.np
                span.badge.badge-outline-primary Layout

            .card
                h5.title BideshJane
                a.link(href="https://www.bideshjane.com/", target="_blank") www.bideshjane.com
                span.badge.badge-outline-primary Portal

        .section-controls
            button.section-control.glider-prev(aria-label="Previous")
                svg(width="8", height="12", viewBox="0 0 8 12", xmlns="http://www.w3.org/2000/svg")
                    path(d="M5.99997 0L7.40997 1.41L2.82997 6L7.40997 10.59L5.99997 12L-2.67029e-05 6L5.99997 0Z")
            button.section-control.section-control--primary.glider-next(aria-label="Next")
                svg(width="10", height="16", viewBox="0 0 10 16", xmlns="http://www.w3.org/2000/svg")
                    path(fill-rule="evenodd", clip-rule="evenodd", d="M0.368774 2.63127L6.09377 8.36877L0.368774 14.1063L2.13127 15.8688L9.63127 8.36877L2.13127 0.868774L0.368774 2.63127Z")

            .card
                h5.title Baozun
                a.link(href="https://www.baozun.com/", target="_blank") www.baozun.com
                span.badge.badge-outline-primary Corporate

        .dots(role="tablist")
