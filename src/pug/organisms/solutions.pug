//- Solutions Section (3-Column Layout)
section.solutions
    .container
        .solutions__header
            .icon-cube
                svg(width="32", height="32", viewBox="0 0 24 24", fill="none", stroke="#091071", stroke-width="2")
                    rect(x="3", y="3", width="18", height="18", rx="2")
                    path(d="M9 3v18M15 3v18M3 9h18M3 15h18")
            
            h2.solutions__title Digital Solutions For #[br] Tomorrow's Business Models.
            p.solutions__description We blend strategic insight with enterprise-grade engineering to help you move faster, operate smarter, and lead your industry.

        .solutions__grid
            //- Item 1
            .solutions__item
                .icon-box
                    svg(width="24", height="24", viewBox="0 0 24 24", fill="none", stroke="#091071", stroke-width="2")
                        path(d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z")
                        path(d="M12 6v6l4 2")
                    span.square-dot
                
                h3.item-title Efficiency Growth
                p.item-desc Streamline your daily operations with custom software that saves time and reduces manual errors.

            //- Item 2
            .solutions__item
                .icon-box
                    svg(width="24", height="24", viewBox="0 0 24 24", fill="none", stroke="#091071", stroke-width="2")
                        path(d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z")
                        polyline(points="3.27 6.96 12 12.01 20.73 6.96")
                        line(x1="12", y1="22.08", x2="12", y2="12")
                    span.square-dot

                h3.item-title Modern Tech Stack
                p.item-desc We use the latest technologies to ensure your digital presence is fast, secure, and ready for the future.

            //- Item 3
            .solutions__item
                .icon-box
                    svg(width="24", height="24", viewBox="0 0 24 24", fill="none", stroke="#091071", stroke-width="2")
                        path(d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z")
                        polyline(points="22,6 12,13 2,6")
                    span.square-dot

                h3.item-title Competitive Advantage
                p.item-desc Stand out in the Nepali market with a unique brand identity and user experience that customers love.
