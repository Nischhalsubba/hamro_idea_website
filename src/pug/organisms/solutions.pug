//- Solutions Section (3-Column Layout)
section.solutions
    .container
        .solutions__header
            .icon-cube.section-icon
                svg(width="24", height="24", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                    rect(x="3", y="3", width="18", height="18", rx="2")
                    path(d="M9 3v18M15 3v18M3 9h18M3 15h18")
            
            h2.solutions__title Digital Solutions For #[br] Nepal's Growth-Focused Businesses.
            p.solutions__description We blend global product standards with local market insight to deliver software that improves revenue, retention, and operational efficiency.

        .solutions__grid
            //- Item 1
            .solutions__item
                .icon-box
                    svg(width="24", height="24", viewBox="0 0 24 24", fill="none", stroke="#091071", stroke-width="2")
                        path(d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z")
                        path(d="M12 6v6l4 2")
                    span.square-dot
                
                h3.item-title Operational Efficiency
                p.item-desc Replace manual workflows with custom software that saves time, reduces errors, and scales with demand.

            //- Item 2
            .solutions__item
                .icon-box
                    svg(width="24", height="24", viewBox="0 0 24 24", fill="none", stroke="#091071", stroke-width="2")
                        path(d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z")
                        polyline(points="3.27 6.96 12 12.01 20.73 6.96")
                        line(x1="12", y1="22.08", x2="12", y2="12")
                    span.square-dot

                h3.item-title Modern, Secure Stack
                p.item-desc We engineer fast, secure platforms with future-ready tech, tailored to your users and your team.

            //- Item 3
            .solutions__item
                .icon-box
                    svg(width="24", height="24", viewBox="0 0 24 24", fill="none", stroke="#091071", stroke-width="2")
                        path(d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z")
                        polyline(points="22,6 12,13 2,6")
                    span.square-dot

                h3.item-title Competitive Advantage
                p.item-desc Stand out with a refined brand experience and conversion-focused UX that keeps customers coming back.
