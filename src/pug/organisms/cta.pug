//- CTA Section
section.cta
    .cta__background
    .container
        .cta__content
            .cta__icon.section-icon
                svg(width="24", height="24", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", xmlns="http://www.w3.org/2000/svg")
                    path(d="M6 4h9l3 3v13H6z")
                    path(d="M9 11h6")
                    path(d="M9 15h6")
            h2.cta__title Let Your Work Speak For Itself.#[br] We'll Handle The Digital.
            p.cta__subtitle We're here to help you navigate your digital journey. Get in touch to discuss how we can take your business to the next level.
            form.cta__form(action="#")
                input.cta__input(type="email", placeholder="Enter your email...", aria-label="Email address")
                button.cta__button(type="submit")
                    span Sign Up
                    span.cta__button-icon →
