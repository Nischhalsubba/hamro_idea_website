//- Navbar
nav.navbar
    .container
        .navbar__wrapper
            a.navbar__brand(href="/") 
                span.navbar__logo-icon
                    svg(width="24", height="24", viewBox="0 0 24 24", fill="none", xmlns="http://www.w3.org/2000/svg")
                        path(d="M12 2L21 7V17L12 22L3 17V7L12 2Z", stroke="white", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
                        path(d="M12 6L16 8.5V13.5L12 16L8 13.5V8.5L12 6Z", fill="white")
                span.navbar__logo-text Hamro Idea

            //- Desktop Menu (Mega Menu)
            ul.navbar__menu-desktop
                //- SERVICES (Mega Menu - Reference Design)
                li.nav-item.has-mega-menu
                    a.nav-link(href="/services/") Services
                    .mega-menu
                        .mega-menu__container.container
                            .mega-menu__layout
                                //- LEFT: Main Services Grid (70%)
                                .mega-menu__main
                                    h6.mega-section-title Core Solutions
                                    .services-grid
                                        //- Item 1: Branding
                                        a.service-card(href="/services/branding-identity/")
                                            .service-card__icon.icon--orange
                                                svg(width="20", height="20", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                                                    path(d="M12 2l9 4.9V17L12 22l-9-4.9V7z")
                                            .service-card__content
                                                h4.service-card__title Branding & Identity
                                                p.service-card__desc Design corporate identities, visual systems, and brand guidelines.

                                        //- Item 2: Web Dev
                                        a.service-card(href="/services/web-development/")
                                            .service-card__icon.icon--blue
                                                svg(width="20", height="20", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                                                    rect(x="3", y="3", width="18", height="18", rx="2", ry="2")
                                                    line(x1="3", y1="9", x2="21", y2="9")
                                            .service-card__content
                                                h4.service-card__title Web Development
                                                p.service-card__desc Custom business websites, web apps, and eCommerce platforms.

                                        //- Item 3: Custom CMS
                                        a.service-card(href="/services/custom-cms/")
                                            .service-card__icon.icon--green
                                                svg(width="20", height="20", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                                                    path(d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z")
                                                    polyline(points="14 2 14 8 20 8")
                                            .service-card__content
                                                h4.service-card__title Custom CMS
                                                p.service-card__desc Tailored content management for WordPress, Drupal, and more.

                                        //- Item 4: Digital Marketing
                                        a.service-card(href="/services/digital-marketing-seo/")
                                            .service-card__icon.icon--purple
                                                svg(width="20", height="20", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                                                    path(d="M23 6l-9.5 9.5-5-5L1 18")
                                                    path(d="M17 6h6v6")
                                            .service-card__content
                                                h4.service-card__title Digital Marketing & SEO
                                                p.service-card__desc SEO audits, technical strategy, and growth analytics.

                                //- RIGHT: Sidebar (30%)
                                .mega-menu__sidebar
                                    h6.mega-section-title Popular Requests
                                    ul.sidebar-list
                                        li: a.sidebar-item(href="#")
                                            span.sidebar-icon 🚀
                                            div
                                                span.sidebar-title Start a New Project
                                                span.sidebar-desc Launch your MVP or Website
                                        li: a.sidebar-item(href="#")
                                            span.sidebar-icon 🛠
                                            div
                                                span.sidebar-title Fix My SEO
                                                span.sidebar-desc Technical audit & optimization
                                        li: a.sidebar-item(href="#")
                                            span.sidebar-icon 🛒
                                            div
                                                span.sidebar-title eCommerce Growth
                                                span.sidebar-desc Shopify & WooCommerce
                                    
                                    .mega-menu__footer-link
                                        a(href="/services/") See all 15+ Services →

                //- SOLUTIONS
                li.nav-item
                    a.nav-link(href="/solutions/") Solutions

                //- WORK
                li.nav-item.has-dropdown
                    a.nav-link(href="/work/") Work
                    ul.dropdown-menu
                        li: a(href="/work/case-studies/") Case Studies
                        li: a(href="/work/client-sites/") Client Websites
                        li: a(href="#") Work by Industry

                //- PROCESS
                li.nav-item.has-dropdown
                    a.nav-link(href="/process/") Process
                    ul.dropdown-menu
                        li: a(href="/process/how-we-work/") Numbered Steps
                        li: a(href="/process/engagement-models/") Retention Models

                //- ABOUT
                li.nav-item.has-dropdown
                    a.nav-link(href="/about/") About
                    ul.dropdown-menu
                        li: a(href="/about/company/") Company
                        li: a(href="/about/team/") Team
                        li: a(href="/about/why-hamro-idea/") Why Hamro Idea

                //- INSIGHTS
                li.nav-item.has-dropdown
                    a.nav-link(href="/insights/") Insights
                    ul.dropdown-menu
                        li: a(href="/insights/blog/") Blog
                        li: a(href="/insights/resources/") Resources

                //- CONTACT
                li.nav-item.has-dropdown
                    a.nav-link(href="/contact/") Contact
                    ul.dropdown-menu
                        li: a(href="/contact/book-a-call/") Book a Call
                        li: a(href="/contact/whatsapp/") WhatsApp

            //- Desktop Actions
            .navbar__actions-desktop
                a.btn.btn--primary(href="/contact/book-a-call/") Book a Call

            //- Mobile Toggle
            button.navbar__toggle(aria-label="Toggle navigation")
                span.navbar__toggle-icon

//- Mobile Overlay (Same as before)
.mobile-nav-overlay
    .mobile-nav-content
        .mobile-nav-header
            span.logo-text Hamro Idea
            button.mobile-nav-close ×
        
        ul.mobile-nav-list
            li: a(href="/") Home
            li.has-submenu
                span Services
                ul.submenu
                    li: a(href="/services/branding-identity/") Branding & Identity
                    li: a(href="/services/web-development/") Website & Web App Dev
                    li: a(href="/services/custom-cms/") Custom CMS Dev
                    li: a(href="/services/digital-marketing-seo/") Digital Marketing & SEO
            li: a(href="/work/") Work
            li: a(href="/process/") Process
            li: a(href="/about/") About
            li: a(href="/insights/") Insights
            li: a(href="/contact/") Contact
        
        .mobile-nav-actions
            a.btn.btn--primary.btn--block(href="/contact/book-a-call/") Book a Call
            .quick-actions
                a(href="/contact/whatsapp/") WhatsApp
                a(href="/contact/email/") Email
