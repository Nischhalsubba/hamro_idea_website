                                                p.service-card__desc Custom business websites, web apps, and eCommerce platforms.

                                        //- Item 3: Custom CMS (Filled Icon)
                                        a.service-card(href="/services/custom-cms.html")
                                            .service-card__icon.icon--green
                                                svg(width="24", height="24", viewBox="0 0 24 24", fill="currentColor", xmlns="http://www.w3.org/2000/svg")
