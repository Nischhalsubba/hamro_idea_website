//- Navbar
nav.navbar(aria-label="Primary")
    .container
        .navbar__wrapper
            a.navbar__brand(href="/") 
                span.navbar__logo-icon
                    img.navbar__logo-img.navbar__logo-img--light(src="assets/images/Logo-white.png", alt="Hamro Idea logo", width="32", height="32", decoding="async")
                    img.navbar__logo-img.navbar__logo-img--dark(src="assets/images/Logo-dark.png", alt="Hamro Idea logo", width="32", height="32", decoding="async")

            //- Desktop Menu (Mega Menu)
            ul.navbar__menu-desktop
                //- SERVICES
                li.nav-item.has-mega-menu(data-mega-target="services")
                    a.nav-link(href="/services/web-development.html") Services

                //- SOLUTIONS
                li.nav-item.has-mega-menu(data-mega-target="solutions")
                    a.nav-link(href="/services/enterprise-software.html") Solutions

                //- WORK
                li.nav-item.has-mega-menu(data-mega-target="work")
                    a.nav-link(href="/work/case-studies.html") Work

                //- PROCESS
                li.nav-item.has-mega-menu(data-mega-target="process")
                    a.nav-link(href="/process/how-we-work.html") Process

                //- ABOUT
                li.nav-item.has-mega-menu(data-mega-target="about")
                    a.nav-link(href="/about/company.html") About

                //- INSIGHTS
                li.nav-item.has-mega-menu(data-mega-target="insights")
                    a.nav-link(href="/insights/blog.html") Insights

                //- CONTACT
                li.nav-item.has-mega-menu(data-mega-target="contact")
                    a.nav-link(href="/contact/book-a-call.html") Contact

            //- Desktop Actions
            .navbar__actions-desktop
                a.btn.btn--primary.btn--icon-block(href="/services/start-a-new-project.html")
                    span.text Start a Project
                    span.btn-icon-box
                        svg(width="12", height="12", viewBox="0 0 16 16", fill="none", xmlns="http://www.w3.org/2000/svg")
                            path(d="M8 0L6.59 1.41L12.17 7H0V9H12.17L6.59 14.59L8 16L16 8L8 0Z", fill="white")

            //- Mobile Toggle
            button.navbar__toggle(aria-label="Toggle navigation", type="button")
                span.navbar__toggle-icon

