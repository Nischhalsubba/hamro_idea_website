//- Navbar
nav.navbar
    .container
        .navbar__wrapper
            a.navbar__brand(href="/") 
                span.navbar__logo-icon
                    img.navbar__logo-img(src="assets/images/Logo-white.png", alt="Hamro Idea logo", width="32", height="32")

            //- Desktop Menu (Mega Menu)
            ul.navbar__menu-desktop
                //- SERVICES
                li.nav-item.has-mega-menu(data-mega-target="services")
                    a.nav-link(href="/services.html") Services

                //- SOLUTIONS
                li.nav-item.has-mega-menu(data-mega-target="solutions")
                    a.nav-link(href="/solutions.html") Solutions

                //- WORK
                li.nav-item.has-mega-menu(data-mega-target="work")
                    a.nav-link(href="/work.html") Work

                //- PROCESS
                li.nav-item.has-mega-menu(data-mega-target="process")
                    a.nav-link(href="/process.html") Process

                //- ABOUT
                li.nav-item.has-mega-menu(data-mega-target="about")
                    a.nav-link(href="/about.html") About

                //- INSIGHTS
                li.nav-item.has-mega-menu(data-mega-target="insights")
                    a.nav-link(href="/insights.html") Insights

                //- CONTACT
                li.nav-item.has-mega-menu(data-mega-target="contact")
                    a.nav-link(href="/contact.html") Contact

            //- Desktop Actions
            .navbar__actions-desktop
                a.btn.btn--primary.btn--icon-block(href="/contact/book-a-call.html")
                    span.text Book a Call
                    span.btn-icon-box
                        svg(width="12", height="12", viewBox="0 0 16 16", fill="none", xmlns="http://www.w3.org/2000/svg")
                            path(d="M8 0L6.59 1.41L12.17 7H0V9H12.17L6.59 14.59L8 16L16 8L8 0Z", fill="white")

            //- Mobile Toggle
            button.navbar__toggle(aria-label="Toggle navigation")
                span.navbar__toggle-icon

