//- Featured Work Section
section.insights.featured-work
    .container
        .insights__header
            .insights__header-content
                .insights__icon.section-icon
                    svg(width="24", height="24", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                        path(d="M4 6h16v12H4z")
                        path(d="M7 9h10v2H7zM7 13h7v2H7z")
                h2.insights__title Featured Work
                p.insights__subtitle Selected project highlights across websites, platforms, design systems, and CMS delivery.
            .insights__header-actions
                a.insights__link(href="/work/case-studies.html") View all work

        .insights__grid
            a.insights__card(href="/work/project-detail.html")
                img.insights__image(src="https://images.unsplash.com/photo-1520607162513-77705c0f0d4a?auto=format&fit=crop&w=900&q=80", alt="Modern enterprise platform dashboard", decoding="async")
                .insights__meta
                    span Software
                    span.insights__tag Platform
                h3 Custom platform interface planned for clearer operations.

            a.insights__card(href="/work/case-studies.html")
                img.insights__image(src="https://images.unsplash.com/photo-1487014679447-9f8336841d58?auto=format&fit=crop&w=900&q=80", alt="Creative branding workshop", decoding="async")
                .insights__meta
                    span CMS
                    span.insights__tag Publishing
                h3 Content platform direction for easier publishing workflows.

            a.insights__card(href="/work/client-sites.html")
                img.insights__image(src="https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&w=900&q=80", alt="Premium website experience on desktop", decoding="async")
                .insights__meta
                    span Website
                    span.insights__tag Experience
                h3 Business website rebuild focused on clarity, speed, and SEO structure.

