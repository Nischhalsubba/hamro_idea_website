//- CTA Section
section.cta
    .cta__background
    .container
        .cta__content
            .cta__icon.section-icon
                svg(width="24", height="24", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", xmlns="http://www.w3.org/2000/svg")
                    path(d="M6 4h9l3 3v13H6z")
                    path(d="M9 11h6")
                    path(d="M9 15h6")
            h2.cta__title Tell us what you want to build.
            p.cta__subtitle Share what you know. You do not need a complete brief.
            form.cta__form(action="/services/start-a-new-project.html")
                input.cta__input(type="email", placeholder="Enter your work email...", aria-label="Work email")
                button.cta__button.btn.btn--icon-block(type="submit")
                    span.text Start a Project
                    span.btn-icon-box
                        svg(width="12", height="12", viewBox="0 0 16 16", fill="none", xmlns="http://www.w3.org/2000/svg")
                            path(d="M8 0L6.59 1.41L12.17 7H0V9H12.17L6.59 14.59L8 16L16 8L8 0Z", fill="white")

