//- What We Build Section
section.services
    .container
        .services__wrapper
            .services__sticky
                .sticky-content
                    .icon-cube.section-icon
                        svg(width="24", height="24", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
                            path(d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z")
                            polyline(points="3.27 6.96 12 12.01 20.73 6.96")
                            line(x1="12", y1="22.08", x2="12", y2="12")
                    h2.services__title What We Build
                    p.services__description Clear digital products for teams that need a stronger website, better software, or a system they can own after launch.

            .services__list
                .service-item
                    span.item-number 01
                    .item-dot
                    h3.item-title Business Websites
                    p.item-desc Fast, responsive websites built for trust, conversion, SEO, and easier content updates.
                    a.item-link(href="/services/web-development.html") Explore Web Development
                        span.arrow →

                .service-item
                    span.item-number 02
                    .item-dot
                    h3.item-title Web Apps
                    p.item-desc Dashboards, portals, booking flows, and product experiences that support real business workflows.
                    a.item-link(href="/services/web-development.html") Explore Web Apps
                        span.arrow →

                .service-item
                    span.item-number 03
                    .item-dot
                    h3.item-title Custom Software
                    p.item-desc Internal tools, workflow systems, and integrations planned around your team instead of generic software limits.
                    a.item-link(href="/services/enterprise-software.html") Explore Custom Software
                        span.arrow →

                .service-item
                    span.item-number 04
                    .item-dot
                    h3.item-title CMS & eCommerce
                    p.item-desc Custom CMS, WordPress, Drupal, Shopify, and WooCommerce builds that are easier to publish and maintain.
                    a.item-link(href="/services/custom-cms.html") Explore CMS
                        span.arrow →

                .service-item
                    span.item-number 05
                    .item-dot
                    h3.item-title Brand & Product Design
                    p.item-desc Brand foundations, product UI, and design systems that make websites and apps feel consistent.
                    a.item-link(href="/services/branding-identity.html") Explore Design
                        span.arrow →

                .service-item
                    span.item-number 06
                    .item-dot
                    h3.item-title SEO & Growth
                    p.item-desc Technical SEO, content structure, site speed, and conversion improvements for sustainable visibility.
                    a.item-link(href="/services/digital-marketing-seo.html") Explore SEO
                        span.arrow →

