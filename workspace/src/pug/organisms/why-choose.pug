//- Why Choose Section
section.why-choose
    .container
        .why-choose__header
            .why-choose__icon.section-icon
                svg(width="24", height="24", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linejoin="round", xmlns="http://www.w3.org/2000/svg")
                    path(d="M12 2L14.9 8.2L21.7 9.2L16.8 13.9L18.1 20.7L12 17.3L5.9 20.7L7.2 13.9L2.3 9.2L9.1 8.2L12 2Z")
            h2.why-choose__title Why Hamro Idea
            p.why-choose__subtitle Strategy, design, development, SEO, and launch support are handled in one practical process by a Nepal-based team ready for local and international work.

        .why-choose__content
            .why-choose__list
                .why-choose__card(data-media="https://images.unsplash.com/photo-1520607162513-77705c0f0d4a?auto=format&fit=crop&w=1200&q=80", data-media-alt="Enterprise dashboard")
                    .why-choose__card-icon
                        svg(width="22", height="22", viewBox="0 0 24 24", fill="none", stroke="#121984", stroke-width="2")
                            rect(x="3", y="3", width="18", height="18", rx="4")
                            path(d="M7 12h10")
                            path(d="M12 7v10")
                    .why-choose__card-body
                        h3 Strategy-first planning
                        p We clarify goals, users, scope, content, and technical constraints before production begins.

                .why-choose__card(data-media="https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1200&q=80", data-media-alt="AI development workflow")
                    .why-choose__card-icon
                        svg(width="22", height="22", viewBox="0 0 24 24", fill="none", stroke="#121984", stroke-width="2")
                            rect(x="3", y="3", width="18", height="18", rx="4")
                            path(d="M7 9h10")
                            path(d="M7 15h10")
                    .why-choose__card-body
                        h3 Design + development together
                        p UX, visual design, frontend, CMS, and backend decisions stay aligned throughout the build.

                .why-choose__card(data-media="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=1200&q=80", data-media-alt="Team collaboration session")
                    .why-choose__card-icon
                        svg(width="22", height="22", viewBox="0 0 24 24", fill="none", stroke="#121984", stroke-width="2")
                            circle(cx="12", cy="12", r="9")
                            path(d="M12 8v4l3 2")
                    .why-choose__card-body
                        h3 SEO and performance aware
                        p Builds include clean structure, responsive layouts, page-speed basics, and handover support.

            .why-choose__media
                img(src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=1200&q=80", alt="Hamro Idea team collaborating", decoding="async", loading="eager", fetchpriority="high")

